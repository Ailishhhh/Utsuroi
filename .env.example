# Utsuroi — environment variables
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real keys.
# For production: set these as EAS secrets (mobile) or in the Vercel dashboard (backend).

# Supabase project URL
#   Supabase dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / public key
#   Supabase dashboard -> Project Settings -> API -> Project API keys -> anon public
#   Safe to ship in the app; it is protected by Row-Level Security.
#   Do NOT use the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
